# Copy to .env.local for local dev (gitignored). On Fly: `fly secrets set ...`.

# GitHub OAuth App (Settings -> Developer settings -> OAuth Apps)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# iron-session cookie encryption password — 32+ chars.
# Generate: openssl rand -hex 32
SESSION_SECRET=

# OAuth callback. Local dev default below; prod = https://gitmap.ratlabs.tech/api/auth/callback
OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/callback
