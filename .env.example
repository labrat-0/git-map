# Copy to .env.local (gitignored) and fill in. See the README for how to create
# the GitHub OAuth App these values come from.

# GitHub OAuth App (Settings -> Developer settings -> OAuth Apps)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# iron-session cookie encryption password — 32+ chars.
# Generate: openssl rand -hex 32
SESSION_SECRET=

# OAuth callback — must exactly match the one set on your GitHub OAuth App.
OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/callback
